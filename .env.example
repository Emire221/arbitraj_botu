# ============================================================================
#  ARBITRAJ BOTU v5.0 — Ortam Değişkenleri (ÖRNEK DOSYA)
#  Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
#
#  [FAZ 2] Yerel State Sync + REVM Simülasyon
#  [FAZ 3] Newton-Raphson Optimal Hacim (Sabit TRADE_SIZE KALDIRILDI)
# ============================================================================

# ─── RPC Bağlantıları (ZORUNLU) ───
# WebSocket — blok başlığı aboneliği için
RPC_WSS_URL=wss://your-base-wss-url/

# HTTP — durum okuma (slot0, liquidity, bytecode) için
RPC_HTTP_URL=https://your-base-http-url/

# ─── Zincir Ayarı ───
# Base = 8453, Ethereum = 1
CHAIN_ID=8453

# ─── Cüzdan (OPSİYONEL — Kontrat tetikleme için) ───
PRIVATE_KEY=
ARBITRAGE_CONTRACT_ADDRESS=

# ─── Havuz A Yapılandırması (Uniswap V3) ───
POOL_A_ADDRESS=0xYourUniswapV3PoolAddress
POOL_A_NAME=Uniswap V3 USDC/WETH %0.05
POOL_A_FEE_BPS=5
POOL_A_DEX=uniswap

# ─── Havuz B Yapılandırması (Aerodrome) ───
POOL_B_ADDRESS=0xYourAerodromePoolAddress
POOL_B_NAME=Aerodrome CL USDC/WETH
POOL_B_FEE_BPS=100
POOL_B_DEX=aerodrome

# ─── Token Decimal Bilgileri ───
# USDC = 6, WETH = 18 (Base Network standart)
TOKEN0_DECIMALS=6
TOKEN1_DECIMALS=18

# ─── Maliyet Parametreleri ───
# Gas maliyeti (Base'de çok düşük)
GAS_COST_USD=0.10
# Aave V3 flash loan ücreti (basis points)
FLASH_LOAN_FEE_BPS=5.0
# Minimum net kâr eşiği (altındakiler atlanır)
MIN_NET_PROFIT_USD=0.50

# ─── Newton-Raphson Optimizasyon ───
# NOT: TRADE_SIZE_ETH artık YOK — miktar otomatik hesaplanır
# Sadece maksimum flash loan limiti belirlenir
MAX_TRADE_SIZE_WETH=50.0

# ─── Veri Tazeliği ───
# Bu süreyi aşan havuz verileri "bayat" kabul edilir (milisaniye)
MAX_STALENESS_MS=2000

# ─── Gösterim ───
# Kaç blokta bir istatistik raporu gösterilsin
STATS_INTERVAL=10

# ─── Yeniden Bağlanma ───
# 0 = sınırsız deneme
MAX_RETRIES=0
