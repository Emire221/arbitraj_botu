# ============================================================================
#  ARBITRAJ BOTU — Ortam Değişkenleri (ÖRNEK DOSYA)
#  Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# ============================================================================

# QuickNode WebSocket RPC URL'si (ZORUNLU)
QUICKNODE_WSS_URL=wss://your-quicknode-url-here/

# Cüzdan Private Key — Kontrat tetikleme için (OPSİYONEL)
# Dikkat: Bu anahtarı kimseyle paylaşmayın!
PRIVATE_KEY=

# Arbitraj Kontrat Adresi — Deploy ettiğiniz kontratın adresi (OPSİYONEL)
ARBITRAGE_CONTRACT_ADDRESS=

# ─── İşlem Parametreleri ───
TRADE_SIZE_ETH=10.0
GAS_COST_USD=25.0
FLASH_LOAN_FEE_BPS=9.0
MIN_NET_PROFIT_USD=5.0

# ─── Görüntüleme ───
STATS_INTERVAL=50

# ─── Yeniden Bağlanma ───
# 0 = sınırsız deneme
MAX_RETRIES=0
